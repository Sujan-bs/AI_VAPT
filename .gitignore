# =========================
# AI_VAPT - .gitignore
# =========================

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual Environment
venv/
.env

# OS junk
.DS_Store
Thumbs.db

# Logs / Outputs (generated files)
logs/
outputs/
scans/

# Ignore all reports by default
reports/*

# BUT allow PDF reports (for GitHub)
!reports/
!reports/*.pdf

# Ignore all generated PDF reports
reports/*.pdf

# But keep one sample report
!reports/8.8.8.8_20260209_115908_report.pdf
